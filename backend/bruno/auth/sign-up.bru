meta {
  name: Sign up
  type: http
  seq: 1
}

post {
  url: {{baseUrl}}/auth/sign-up/email
  body: json
  auth: none
}

body:json {
  {
    "name": "{{name}}",
    "email": "{{email}}",
    "password": "{{password}}"
  }
}

vars:pre-request {
  name: test
  email: test@gmail.com
  password: testtest
  baseUrl: http://localhost:3000
}

script:post-response {
  if (res.body?.token) {
    bru.setVar("token", res.body.token);
  }
}
