meta {
  name: Sign in
  type: http
  seq: 2
}

post {
  url: {{baseUrl}}/auth/sign-in/email
  body: json
  auth: none
}

body:json {
  {
    "email": "{{email}}",
    "password": "{{password}}"
  }
}

vars:pre-request {
  baseUrl: http://localhost:3000
  email: test@gmail.com
  password: testtest
}

script:post-response {
  if (res.body?.token) {
    bru.setVar("token", res.body.token);
  }
}
