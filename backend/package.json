{
  "name": "backend",
  "private": true,
  "type": "module",
  "module": "index.ts",
  "scripts": {
    "dev": "bun run --hot src/index.ts",
    "start": "bun run src/index.ts",
    "build": "bun build src/index.ts --target bun --outdir dist",
    "db:up": "docker compose up -d",
    "db:down": "docker compose down",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "bun run src/db/migrate.ts",
    "db:studio": "drizzle-kit studio",
    "auth:generate": "bunx --bun auth generate --config src/lib/auth.ts --output src/db/schema/auth.ts -y",
    "test": "bun test",
    "test:setup": "NODE_ENV=test bun run src/db/create-database.ts && NODE_ENV=test bun run db:migrate",
    "lint": "oxlint --fix",
    "lint:check": "oxlint",
    "format": "oxfmt",
    "format:check": "oxfmt --check",
    "types:check": "tsc",
    "fix": "bun run lint && bun run format",
    "check": "bun run lint:check && bun run format:check && bun run types:check"
  },
  "dependencies": {
    "@hono/zod-validator": "^0.9.1",
    "better-auth": "^1.7.7",
    "drizzle-orm": "^0.45.4",
    "hono": "^4.13.13",
    "zod": "^4.6.6"
  },
  "devDependencies": {
    "@types/bun": "latest",
    "auth": "^1.7.7",
    "drizzle-kit": "^0.31.11",
    "oxfmt": "^0.72.0",
    "oxlint": "^1.87.0"
  },
  "peerDependencies": {
    "typescript": "^7"
  },
  "packageManager": "bun@1.4.2"
}
