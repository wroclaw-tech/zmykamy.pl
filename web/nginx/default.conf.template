# Rendered by the nginx image's envsubst step on startup; only variables defined
# in the environment are replaced, so nginx's own $variables stay intact.

server {
    listen 80;
    server_name _;
    root /usr/share/nginx/html;

    # TLS is terminated by the reverse proxy in front (Coolify), so Apple's crawler
    # must get a 200 here without any redirect.
    location = /.well-known/apple-app-site-association {
        default_type application/json;
        add_header Cache-Control "public, max-age=3600";
    }

    # The backend renders the invite page with the trip name for people without the app.
    location /j/ {
        proxy_pass ${BACKEND_URL};
        proxy_ssl_server_name on;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    location / {
        try_files $uri $uri/ =404;
    }

    error_page 404 /404.html;
}
